{
  "name": "@printstream/bridge",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "description": "Desktop tray bridge for connecting LAN Bambu printers to PrintStream.",
  "homepage": "https://github.com/RyanEwen/printstream",
  "author": {
    "name": "PrintStream",
    "email": "noreply@printstream.local"
  },
  "main": "dist/index.js",
  "exports": {
    "./runtime": "./dist/runtime.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS=\"--require ../../scripts/dev/exit-with-parent.cjs\" node ../../scripts/dev/run-service-dev.mjs --name=bridge --entry=src/index.ts --env-file=../../.env --watch=src --watch=../../packages/shared/dist --watch=../../packages/bridge-runtime/dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@printstream/bridge-runtime": "1.3.3",
    "@printstream/sea-runtime": "1.3.3",
    "@printstream/shared": "1.3.3",
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.1",
    "ws": "^8.18.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/ws": "^8.5.13",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.25.5",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.13"
  }
}
