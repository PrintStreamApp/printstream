{
  "name": "@printstream/api",
  "version": "1.3.14",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./dist/server.js",
    "./license-origin": "./dist/lib/license-origin.js",
    "./native-update": "./dist/lib/native-update.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "npm run build --workspace @printstream/shared",
    "dev": "NODE_OPTIONS=\"--require ../../scripts/dev/exit-with-parent.cjs\" node ../../scripts/dev/run-service-dev.mjs --name=api --entry=src/server.ts --watch=src --watch=../../packages/shared/dist --watch=../../packages/bridge-runtime/dist",
    "prisma:db:push": "prisma db push",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:reset-auth": "tsx scripts/dev/reset-auth.ts",
    "db:seed:dev": "tsx scripts/dev/seed-dev.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@printstream/bridge-runtime": "1.3.14",
    "@printstream/sea-runtime": "1.3.14",
    "@printstream/shared": "1.3.14",
    "@prisma/client": "^6.5.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "basic-ftp": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.1.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "jpeg-js": "^0.4.4",
    "marked": "^18.0.6",
    "mqtt": "^5.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "occt-import-js": "^0.0.23",
    "pg": "^8.16.0",
    "pngjs": "^7.0.0",
    "three": "^0.186.0",
    "undici": "^7.25.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "prisma": "^6.5.0",
    "tsx": "^4.23.13"
  }
}
